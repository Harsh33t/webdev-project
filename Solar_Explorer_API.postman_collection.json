    {
      "name": "1. Authentication APIs",
      "description": "User registration, password hashing (bcrypt/SHA256 salt), session retrieval, profile lookups, and session teardown.",
      "item": [
        {
          "name": "POST Register New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 409 Conflict\", function () {",
                  "    pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"User record created with sanitized credentials\", function () {",
                  "        var jsonData = pm.response.json();",
                  "        pm.expect(jsonData.success).to.eql(true);",
                  "        pm.expect(jsonData.user).to.have.property('username');",
                  "        pm.expect(jsonData.user).to.not.have.property('passwordHash');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"astronomer_pratham\",\n  \"password\": \"CosmicOrbital2026!\",\n  \"displayName\": \"Pratham (Lead Architect)\",\n  \"email\": \"pratham.explorer@solar-mission.space\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Registers a new user account. Passwords are encrypted before storage. Returns 201 Created or 409 Conflict if user exists."
