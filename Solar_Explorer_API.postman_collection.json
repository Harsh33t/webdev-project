    {
      "name": "2. CRUD Operations (Celestial Observations)",
      "description": "Full RESTful CRUD on Celestial Observations fulfilling End-Term Rubric Criteria (MongoDB Mongoose ODM + Dual-Storage fallback).",
      "item": [
        {
          "name": "POST Create Celestial Observation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Observation created with valid ID\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    var createdId = jsonData.data._id || jsonData.data.id;",
                  "    pm.collectionVariables.set(\"sampleObservationId\", createdId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"High-Resolution Solar Prominence Eruption\",\n  \"category\": \"Solar Flare\",\n  \"celestialObject\": \"The Sun (Active Region AR3664)\",\n  \"observerName\": \"Aviraj\",\n  \"location\": \"Mount Abu Solar Ground Station\",\n  \"coordinates\": \"Helio Lat 18° S, Long 42° W\",\n  \"telescopeEquipment\": \"Coronado SolarMax III 70mm H-Alpha Double Stack\",\n  \"seeingCondition\": \"Pickering 8 (Sub-arcsecond stability)\",\n  \"notes\": \"Spectacular coronal mass ejection loop observed in Hydrogen-Alpha wavelength (656.28 nm). Plasma loop reached estimated 120,000 km altitude.\",\n  \"rating\": 5,\n  \"status\": \"verified\"\n}"
            },
