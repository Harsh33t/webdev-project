              "raw": "{{baseUrl}}/api/observations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "observations"]
            },
            "description": "Creates a new celestial observation record in MongoDB using Mongoose ODM with validation and fallback to local JSON."
          }
        },
