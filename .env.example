# ==============================================================================
# Solar Explorer - Environment Configuration Template (.env.example)
# Copy this file to '.env' and update values for your local or cloud setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port on which the Express HTTP mission control server will listen
PORT=3000

# Node runtime environment mode:
# - 'development': enables verbose diagnostic logs and stack traces
# - 'production': enables production optimizations and hardened error masks
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Mongoose ODM / MongoDB)
# ------------------------------------------------------------------------------
# The application seamlessly supports BOTH Local MongoDB and MongoDB Atlas.
#
# Option A: Local MongoDB Daemon (Default)
#   Ensure the local 'mongod' service is active on standard port 27017.
MONGODB_URI=mongodb://127.0.0.1:27017/solar_explorer
#
# Option B: MongoDB Atlas Cloud Cluster
#   1. Sign in to https://cloud.mongodb.com
#   2. Create a cluster (e.g., M0 Free Tier).
#   3. Under 'Database Access', create a database user with readWrite privileges.
#   4. Under 'Network Access', add IP Whitelist 0.0.0.0/0 (or your specific IP).
#   5. Click 'Connect' -> 'Drivers' -> 'Node.js' and paste your connection string below:
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/solar_explorer?retryWrites=true&w=majority
#   (Note: Remember to percent-encode special characters like @, #, : in your password)
#
# Resilience Note:
# If MongoDB or Atlas is offline or unreachable, the application automatically
# switches to the Dual-Storage Local JSON Fallback mode so the server NEVER crashes!

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Secret key used for password hashing, session tokens, and cryptographic signing
SESSION_SECRET=solar_explorer_ultra_secret_jwt_and_session_key_2026

# ------------------------------------------------------------------------------
# 4. LOCAL PERSISTENCE STORAGE
# ------------------------------------------------------------------------------
# Directory relative to project root where local JSON databases and email receipts are saved
STORAGE_FILE_DIR=data

# ------------------------------------------------------------------------------
# 5. OPTIONAL: SMTP EMAIL DISPATCH (Order Receipts)
# ------------------------------------------------------------------------------
# If omitted, Solar Explorer automatically provisions an Ethereal sandbox test account
# with live one-click web preview URLs and writes HTML receipts to data/email_receipts/.
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_SECURE=false
